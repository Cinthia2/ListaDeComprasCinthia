<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Campo de pesquisa -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputPesquisa"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:hint="@string/pesquisar_produto"
            app:boxCornerRadiusBottomEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusTopStart="24dp"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPesquisa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pesquisar_produto"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Barra de ações: marcar todos + remover -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <CheckBox
                android:id="@+id/marcar_todos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/marcar_todos"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/id_remover"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remover"
                android:textAllCaps="false"
                android:textColor="@color/vermelho_remover"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_delete_24"
                app:iconTint="@color/vermelho_remover"
                app:strokeColor="@color/vermelho_remover" />
        </LinearLayout>

        <!-- Resumo: quantos itens faltam -->
        <TextView
            android:id="@+id/resultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            tools:text="Faltam 12 de 58 itens" />

        <!-- Lista agrupada por categoria -->
        <ExpandableListView
            android:id="@+id/listaCategorias"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:childDivider="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:groupIndicator="@null"
            android:paddingBottom="96dp" />

        <!-- Mostrado quando a pesquisa não encontra nada -->
        <TextView
            android:id="@+id/listaVazia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/nenhum_produto_encontrado"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnNovoProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/adicionar_produto"
        android:text="@string/novo_produto"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/roxo_principal"
        app:icon="@drawable/ic_add_24"
        app:iconTint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

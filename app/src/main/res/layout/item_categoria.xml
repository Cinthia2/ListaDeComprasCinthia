<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho de cada categoria (grupo da ExpandableListView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/bolinhaCategoria"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_bolinha" />

    <TextView
        android:id="@+id/nomeCategoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Produtos Alimentícios" />

    <TextView
        android:id="@+id/contadorCategoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_contador"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="3/38" />

    <ImageView
        android:id="@+id/setaCategoria"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_expand_more_24" />
</LinearLayout>
